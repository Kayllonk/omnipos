import { useEffect, useMemo, useState } from 'react'
import axios from 'axios'
import { Activity, ArrowUpRight, Boxes, CreditCard, ShieldCheck, ShoppingBag, Users, TrendingUp, AlertTriangle } from 'lucide-react'
import { useAuth } from '../auth/AuthContext'
import Sidebar from '../components/Sidebar'
import Topbar from '../components/Topbar'
import SalesChart from '../components/SalesChart'

const api = axios.create({ baseURL: '' })

export default function DashboardPage() {
  const { token, user, logout } = useAuth()
  const [active, setActive] = useState('Dashboard')
  const [data, setData] = useState({
    total_products: 0,
    active_products: 0,
    low_stock: 0,
    total_sales: 0,
    revenue: 0
  })

  const headers = useMemo(() => ({ Authorization: `Bearer ${token}` }), [token])

  useEffect(() => {
    api.get('/api/dashboard', { headers })
      .then(r => setData(r.data))
  }, [headers])

  const stats = [
    ['Produtos', data.total_products, Boxes, 'total do catálogo'],
    ['Ativos', data.active_products, ShieldCheck, 'operando normalmente'],
    ['Baixo estoque', data.low_stock, AlertTriangle, 'precisa reposição'],
    ['Vendas', data.total_sales, CreditCard, 'transações registradas']
  ]

  const revenueToday = Number(data.revenue || 0).toFixed(2)

  return (
    <div className="min-h-screen p-4">
      <div className="grid lg:grid-cols-[280px_1fr] gap-4">
        <Sidebar active={active} onChange={setActive} onLogout={logout} />

        <main className="space-y-4">
          <Topbar user={user} />

          <section className="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
            {stats.map(([label, value, Icon, subtitle]) => (
              <div key={label} className="glass rounded-3xl p-5 shadow-glow">
                <div className="flex items-center justify-between">
                  <div className="text-slate-300 text-sm">{label}</div>
                  <Icon className="w-5 h-5 text-cyan" />
                </div>
                <div className="mt-4 text-4xl font-black text-white">{value}</div>
                <div className="mt-3 text-sm text-emerald-300 flex items-center gap-1">
                  <ArrowUpRight className="w-4 h-4" />
                  {subtitle}
                </div>
              </div>
            ))}
          </section>

          <section className="grid xl:grid-cols-[1.6fr_1fr] gap-4">
            <div className="glass rounded-3xl p-6">
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h3 className="text-xl font-bold">Performance de vendas</h3>
                  <p className="text-sm text-slate-400">últimos 12 meses</p>
                </div>
                <div className="text-right">
                  <div className="text-xs text-slate-400">Receita total</div>
                  <div className="text-2xl font-black text-primary">R$ {revenueToday}</div>
                </div>
              </div>
              <SalesChart />
            </div>

            <div className="space-y-4">
              <div className="glass rounded-3xl p-6">
                <h3 className="text-xl font-bold mb-4">Resumo inteligente</h3>
                <div className="grid grid-cols-2 gap-3">
                  <div className="rounded-2xl bg-white/5 p-4">
                    <div className="text-xs text-slate-400">Status</div>
                    <div className="mt-2 text-2xl font-black text-cyan">Online</div>
                  </div>
                  <div className="rounded-2xl bg-white/5 p-4">
                    <div className="text-xs text-slate-400">Usuário</div>
                    <div className="mt-2 text-lg font-bold text-white">{user?.username || '—'}</div>
                  </div>
                  <div className="rounded-2xl bg-white/5 p-4">
                    <div className="text-xs text-slate-400">Catálogo</div>
                    <div className="mt-2 text-2xl font-black text-white">{data.total_products}</div>
                  </div>
                  <div className="rounded-2xl bg-white/5 p-4">
                    <div className="text-xs text-slate-400">Estoque baixo</div>
                    <div className="mt-2 text-2xl font-black text-amber-300">{data.low_stock}</div>
                  </div>
                </div>
              </div>

              <div className="glass rounded-3xl p-6">
                <h3 className="text-xl font-bold mb-4">Alertas</h3>
                <div className="space-y-3 text-sm">
                  <div className="rounded-2xl bg-amber-500/10 border border-amber-500/20 p-4 flex items-start gap-3">
                    <AlertTriangle className="w-5 h-5 text-amber-300 mt-0.5" />
                    <div>Produtos abaixo do mínimo devem ser repostos com prioridade.</div>
                  </div>
                  <div className="rounded-2xl bg-cyan-500/10 border border-cyan-500/20 p-4 flex items-start gap-3">
                    <TrendingUp className="w-5 h-5 text-cyan mt-0.5" />
                    <div>Dashboard protegido com autenticação JWT e rotas seguras.</div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section className="grid md:grid-cols-3 gap-4">
            <div className="glass rounded-3xl p-5">
              <div className="flex items-center justify-between">
                <div className="text-sm text-slate-400">Produtos ativos</